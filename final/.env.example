# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database
# Optional Supabase transaction/session pooler URL. When set, this is preferred
# over DATABASE_URL and can work on VPNs that restrict direct Postgres traffic.
DATABASE_URL_POOLER=

# Canonical client IP. Choose cloudflare, vercel, generic, or leave unset locally.
TRUSTED_PROXY_PROVIDER=vercel
# Required only when TRUSTED_PROXY_PROVIDER=generic.
TRUSTED_CLIENT_IP_HEADER=x-real-ip

# Server-side IP enrichment: maxmind, ipapi, or none.
IP_ENRICHMENT_PROVIDER=ipapi
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
TOR_EXIT_LOOKUP=true

# First-party network path research. The probe hosts should resolve exclusively
# to IPv4 and IPv6 respectively and deploy this same app/route.
IPV4_PROBE_URL=https://v4.example.gov/api/path-probe?kind=ipv4
IPV6_PROBE_URL=https://v6.example.gov/api/path-probe?kind=ipv6
PROBE_SIGNING_SECRET=replace-with-at-least-32-random-bytes
RESEARCH_APP_ORIGIN=https://research.example.gov

# Prefer an owned/contracted STUN service. Public Google STUN is disabled by default.
STUN_URL=stun:stun.example.gov:3478
ALLOW_PUBLIC_STUN=false

# Anti-replay and protected component identifiers.
SCAN_SIGNING_SECRET=replace-with-a-different-32-byte-secret
FINGERPRINT_HMAC_SECRET=replace-with-a-different-32-byte-secret

# Research model base rate. This must be recalibrated using deployment data.
VPN_RISK_PRIOR=0.05

# Optional trusted-ingress transport fields.
JA4_HEADER_NAME=
HTTP_PROTOCOL_HEADER_NAME=

# Scheduled retention endpoint: POST /api/maintenance/retention with Bearer token.
RAW_OBSERVATION_RETENTION_DAYS=30
MAINTENANCE_TOKEN=replace-with-a-different-32-byte-secret

# Linkage model. Optional fixed prior for "same device" (default 1 / (devices + 1), max 0.1).
LINKAGE_PRIOR=

# CalcuLatency-style evidence: header set only by trusted ingress, e.g. nginx
#   proxy_set_header X-TCP-RTT $tcpinfo_rtt;   (microseconds)
TCP_RTT_HEADER_NAME=
TCP_RTT_HEADER_UNIT=us
# Server location for the speed-of-light GeoIP feasibility check.
SERVER_LATITUDE=
SERVER_LONGITUDE=

# Local development store used when no database URL is set.
RESEARCH_FILE_STORE=

# "Start a fresh comparison set" (Saved data page). Store only the scrypt hash:
#   npm run hash-password   (type the password, press Enter, then Ctrl-D)
# Leave empty to disable archiving.
ARCHIVE_PASSWORD_HASH=
